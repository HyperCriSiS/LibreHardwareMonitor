<ui:DecoratedWindow x:Class="LibreHardwareMonitor.Avalonia.UI.Views.MainWindow"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:LibreHardwareMonitor.Avalonia.UI.Converters"
                    xmlns:data="using:BlackSharp.UI.Avalonia.Data"
                    xmlns:global="using:LibreHardwareMonitor.Avalonia.UI.Application"
                    xmlns:language="using:LibreHardwareMonitor.Avalonia.Localization.Resources"
                    xmlns:mockData="using:LibreHardwareMonitor.Avalonia.UI.MockData"
                    xmlns:primitives="using:BlackSharp.UI.Avalonia.TreeDataGrid.Primitives"
                    xmlns:tree="using:BlackSharp.UI.Avalonia.TreeDataGrid"
                    xmlns:ui="using:BlackSharp.UI.Avalonia.Controls"
                    xmlns:vm="using:LibreHardwareMonitor.Avalonia.Mvvm.ViewModels"
                    x:DataType="vm:MainWindowViewModel"
                    Design.DataContext="{x:Static mockData:MainWindowDesignData.MainWindow}"
                    Title="{x:Static language:Resources.ApplicationTitle}"
                    Icon="{StaticResource LibreHardwareMonitorWindowIcon}"
                    TitleBarIcon="{StaticResource LibreHardwareMonitorTitleBarIcon}"
                    Width="1240" Height="720"
                    MinWidth="600" MinHeight="400"
                    WindowStartupLocation="CenterScreen">

    <ui:DecoratedWindow.Resources>
        <converters:SensorIconConverter x:Key="SensorIconConverter"/>
        <converters:HistoryPointsConverter x:Key="DetailHistoryConverter"
                                           Width="236"
                                           Height="80"
                                           Length="0"/>
    </ui:DecoratedWindow.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          ColumnDefinitions="*,Auto">
        <WrapPanel Grid.Row="0"
                   Grid.ColumnSpan="2"
                   ItemSpacing="8"
                   LineSpacing="8"
                   Margin="12,12,12,0">
            <TextBlock VerticalAlignment="Center"
                       Text="{x:Static language:Resources.GroupingLabel}"/>
            <ComboBox AutomationProperties.Name="{x:Static language:Resources.GroupingLabel}"
                      DisplayMemberBinding="{Binding Name}"
                      ItemsSource="{Binding Groupings}"
                      SelectedItem="{Binding SelectedGrouping}"/>
            <TextBlock VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Text="{x:Static language:Resources.SortLabel}"/>
            <ComboBox AutomationProperties.Name="{x:Static language:Resources.SortLabel}"
                      DisplayMemberBinding="{Binding Name}"
                      ItemsSource="{Binding SortOrders}"
                      SelectedItem="{Binding SelectedSortOrder}"/>
            <TextBox Width="180"
                     AutomationProperties.Name="{x:Static language:Resources.FilterPlaceholder}"
                     PlaceholderText="{x:Static language:Resources.FilterPlaceholder}"
                     Text="{Binding FilterText}"/>
            <ToggleButton Content="{x:Static language:Resources.ShowAdvanced}"
                          IsChecked="{Binding ShowAdvanced}"/>
            <ToggleButton Content="{x:Static language:Resources.ShowHiddenSensors}"
                          IsChecked="{Binding ShowHidden}"/>
            <Button Content="{x:Static language:Resources.MappingOpen}"
                    Click="OnMappingClick"/>
            <ToggleButton Content="{x:Static language:Resources.DetailsLabel}"
                          IsChecked="{Binding IsDetailsVisible}"/>
            <ToggleButton Content="{x:Static language:Resources.DashboardLabel}"
                          IsChecked="{Binding IsDashboardVisible}"/>
            <Button Content="{x:Static language:Resources.OptionsLabel}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="8"
                                    MaxWidth="360">
                            <CheckBox Content="{x:Static language:Resources.UseFahrenheit}"
                                      IsChecked="{Binding UseFahrenheit}"/>
                            <CheckBox Content="{x:Static language:Resources.TrayIconEnabled}"
                                      IsChecked="{Binding IsTrayIconEnabled}"/>
                            <CheckBox Margin="24,0,0,0"
                                      Content="{x:Static language:Resources.MinimizeToTray}"
                                      IsEnabled="{Binding IsTrayIconEnabled}"
                                      IsChecked="{Binding IsMinimizeToTray}"/>
                            <CheckBox Content="{x:Static language:Resources.LoggingEnabled}"
                                      IsChecked="{Binding IsLoggingEnabled}"/>
                            <Button Margin="24,0,0,0"
                                    Content="{x:Static language:Resources.LoggingOpenFolder}"
                                    IsEnabled="{Binding IsLoggingEnabled}"
                                    Click="OnOpenLogFolderClick"/>
                            <CheckBox Content="{x:Static language:Resources.WebServerEnabled}"
                                      IsChecked="{Binding IsWebServerEnabled}"/>
                            <CheckBox Margin="24,0,0,0"
                                      Content="{x:Static language:Resources.WebServerLocalOnly}"
                                      IsChecked="{Binding IsWebServerLocalOnly}"/>
                            <SelectableTextBlock Margin="24,0,0,0"
                                                 Opacity="0.7"
                                                 TextWrapping="Wrap"
                                                 IsVisible="{Binding IsWebServerEnabled}"
                                                 Text="{Binding WebServerStatus}"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </WrapPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="12"
                      IsVisible="{Binding IsDashboardVisible}">
            <Panel>
                <TextBlock Opacity="0.7"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasTiles}"
                           Text="{x:Static language:Resources.DashboardEmpty}"/>
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="12"
                                       LineSpacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardTileViewModel">
                            <Border Width="220"
                                    Padding="12"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static language:Resources.DashboardUnpin}"
                                                  Click="OnUnpinTileClick"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Name}"/>
                                    <TextBlock Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding HardwareName}"/>
                                    <TextBlock FontSize="26"
                                               Text="{Binding Value}"/>
                                    <Polyline Height="36"
                                              Width="196"
                                              StrokeThickness="1.5"
                                              Stroke="{DynamicResource SystemControlHighlightAccentBrush}"
                                              Points="{Binding History, Converter={x:Static converters:HistoryPointsConverter.Instance}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </ScrollViewer>

        <tree:TreeDataGrid Grid.Row="1"
                           Margin="12"
                           IsVisible="{Binding !IsDashboardVisible}"
                           ItemsSource="{Binding Hardware}"
                           SelectedItem="{Binding SelectedNode, Mode=OneWayToSource}"
                           ExpanderChevronHeight="{data:ScaleFontBinding Path=GlobalFontSize, Source={x:Static global:Global.FontManager}}"
                           ExpanderChevronWidth="{data:ScaleFontBinding Path=GlobalFontSize, Source={x:Static global:Global.FontManager}}"
                           CanUserReorderColumns="False"
                           CanUserResizeColumns="True"
                           CanUserSortColumns="False"
                           ExpandCollapseOnDoubleTap="True"
                           SelectParentOnLeftArrow="True"
                           PreserveSelectionOnCtrlArrowScroll="True"
                           GridLinesVisibility="Horizontal"
                           SelectionMode="Row,Multiple"
                           KeyDown="OnTreeKeyDown"
                           SelectionChanged="OnTreeSelectionChanged"
                           ScrollViewer.AllowAutoHide="False"
                           MinWidth="300">
            <tree:TreeDataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static language:Resources.ExpandAll}"
                              Click="OnExpandAllClick"/>
                    <MenuItem Header="{x:Static language:Resources.CollapseAll}"
                              Click="OnCollapseAllClick"/>
                    <Separator/>
                    <MenuItem Header="{x:Static language:Resources.Rename}"
                              InputGesture="F2"
                              Click="OnRenameClick"/>
                    <MenuItem Header="{x:Static language:Resources.HideSensors}"
                              InputGesture="Delete"
                              Click="OnHideClick"/>
                    <MenuItem Header="{x:Static language:Resources.ShowSensors}"
                              Click="OnShowClick"/>
                    <Separator/>
                    <MenuItem Header="{x:Static language:Resources.DashboardPin}"
                              Click="OnPinClick"/>
                    <MenuItem Header="{x:Static language:Resources.DashboardUnpin}"
                              Click="OnUnpinClick"/>
                </ContextMenu>
            </tree:TreeDataGrid.ContextMenu>

            <tree:TreeDataGrid.Styles>
                <Style Selector="Button.expand-all">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Opacity" Value="0"/>
                </Style>
                <Style Selector="primitives|TreeDataGridRow:pointerover Button.expand-all, Button.expand-all:focus-visible">
                    <Setter Property="Opacity" Value="0.7"/>
                </Style>
                <Style Selector="Button.column-caption">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="6,0,10,0"/>
                    <Setter Property="Opacity" Value="0.6"/>
                    <Setter Property="FontSize" Value="11"/>
                </Style>
                <Style Selector="primitives|TreeDataGridTextCell">
                    <Setter Property="Padding" Value="6,2,10,2"/>
                </Style>
            </tree:TreeDataGrid.Styles>

            <tree:TreeDataGrid.Columns>
                <!-- Hardware/Sensor Name -->
                <tree:TreeDataGridHierarchicalExpanderColumn x:DataType="vm:SensorTreeNodeViewModel"
                                                             Header="{x:Static language:Resources.ColumnSensor}"
                                                             Width="4*"
                                                             MinWidth="180"
                                                             ChildrenBinding="{CompiledBinding Children}"
                                                             IsExpandedBinding="{CompiledBinding IsExpanded, Mode=TwoWay}">
                    <tree:TreeDataGridHierarchicalExpanderColumn.Inner>
                        <tree:TreeDataGridTemplateColumn>
                            <tree:TreeDataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:SensorTreeNodeViewModel">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                Margin="6,2,10,2">
                                        <Image Width="{data:ScaleFontBinding Path=GlobalFontSize, Factor=1.33, Source={x:Static global:Global.FontManager}}"
                                               Height="{data:ScaleFontBinding Path=GlobalFontSize, Factor=1.33, Source={x:Static global:Global.FontManager}}"
                                               MaxWidth="16"
                                               MaxHeight="16"
                                               Source="{Binding IconName, Converter={StaticResource SensorIconConverter}}"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   Opacity="{Binding IsHidden, Converter={x:Static converters:HiddenOpacityConverter.Instance}}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Classes="expand-all"
                                                IsVisible="{Binding HasNestedChildren}"
                                                Content="&#x21C5;"
                                                ToolTip.Tip="{x:Static language:Resources.ToggleAllHint}"
                                                AutomationProperties.Name="{x:Static language:Resources.ToggleAllHint}"
                                                Click="OnToggleAllClick"/>
                                    </StackPanel>
                                </DataTemplate>
                            </tree:TreeDataGridTemplateColumn.CellTemplate>
                        </tree:TreeDataGridTemplateColumn>
                    </tree:TreeDataGridHierarchicalExpanderColumn.Inner>
                </tree:TreeDataGridHierarchicalExpanderColumn>

                <!-- Sensor Value -->
                <tree:TreeDataGridTemplateColumn x:DataType="vm:SensorTreeNodeViewModel"
                                                 Header="{x:Static language:Resources.ColumnValue}"
                                                 Width="*"
                                                 MinWidth="80">
                    <tree:TreeDataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorTreeNodeViewModel">
                            <Panel>
                                <TextBlock Margin="6,2,10,2"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           IsVisible="{Binding !IsCategory}"
                                           Text="{Binding Value}"/>
                                <Button Classes="column-caption"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding IsCategory}"
                                        Content="{Binding Value}"
                                        Tag="Value"
                                        ToolTip.Tip="{x:Static language:Resources.SortColumnHint}"
                                        Click="OnColumnCaptionClick"/>
                            </Panel>
                        </DataTemplate>
                    </tree:TreeDataGridTemplateColumn.CellTemplate>
                </tree:TreeDataGridTemplateColumn>

                <!-- Sensor Minimum -->
                <tree:TreeDataGridTemplateColumn x:DataType="vm:SensorTreeNodeViewModel"
                                                 Header="{x:Static language:Resources.ColumnMinimum}"
                                                 Width="*"
                                                 MinWidth="80">
                    <tree:TreeDataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorTreeNodeViewModel">
                            <Panel>
                                <TextBlock Margin="6,2,10,2"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           IsVisible="{Binding !IsCategory}"
                                           Text="{Binding Min}"/>
                                <Button Classes="column-caption"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding IsCategory}"
                                        Content="{Binding Min}"
                                        Tag="Min"
                                        ToolTip.Tip="{x:Static language:Resources.SortColumnHint}"
                                        Click="OnColumnCaptionClick"/>
                            </Panel>
                        </DataTemplate>
                    </tree:TreeDataGridTemplateColumn.CellTemplate>
                </tree:TreeDataGridTemplateColumn>

                <!-- Sensor Maximum -->
                <tree:TreeDataGridTemplateColumn x:DataType="vm:SensorTreeNodeViewModel"
                                                 Header="{x:Static language:Resources.ColumnMaximum}"
                                                 Width="*"
                                                 MinWidth="80">
                    <tree:TreeDataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorTreeNodeViewModel">
                            <Panel>
                                <TextBlock Margin="6,2,10,2"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           IsVisible="{Binding !IsCategory}"
                                           Text="{Binding Max}"/>
                                <Button Classes="column-caption"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding IsCategory}"
                                        Content="{Binding Max}"
                                        Tag="Max"
                                        ToolTip.Tip="{x:Static language:Resources.SortColumnHint}"
                                        Click="OnColumnCaptionClick"/>
                            </Panel>
                        </DataTemplate>
                    </tree:TreeDataGridTemplateColumn.CellTemplate>
                </tree:TreeDataGridTemplateColumn>

                <!-- Sensor Average -->
                <tree:TreeDataGridTemplateColumn x:DataType="vm:SensorTreeNodeViewModel"
                                                 Header="{x:Static language:Resources.ColumnAverage}"
                                                 Width="*"
                                                 MinWidth="80">
                    <tree:TreeDataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SensorTreeNodeViewModel">
                            <Panel>
                                <TextBlock Margin="6,2,10,2"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           IsVisible="{Binding !IsCategory}"
                                           Text="{Binding Average}"/>
                                <Button Classes="column-caption"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding IsCategory}"
                                        Content="{Binding Average}"
                                        Tag="Average"
                                        ToolTip.Tip="{x:Static language:Resources.SortColumnHint}"
                                        Click="OnColumnCaptionClick"/>
                            </Panel>
                        </DataTemplate>
                    </tree:TreeDataGridTemplateColumn.CellTemplate>
                </tree:TreeDataGridTemplateColumn>
            </tree:TreeDataGrid.Columns>
        </tree:TreeDataGrid>

        <ScrollViewer x:Name="DetailsPane"
                      Grid.Row="1"
                      Grid.Column="1"
                      Width="260"
                      Margin="0,12,12,12"
                      IsVisible="{Binding IsDetailsVisible}">
            <StackPanel>
                <StackPanel Margin="0,0,0,12"
                            IsVisible="{Binding SelectedHistoryRange, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock FontWeight="SemiBold"
                               Text="{x:Static language:Resources.HistoryLabel}"/>
                    <Border Margin="0,4,0,2"
                            Padding="0,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <Polyline Height="80"
                                  Width="236"
                                  StrokeThickness="1.5"
                                  Stroke="{DynamicResource SystemControlHighlightAccentBrush}"
                                  Points="{Binding SelectedHistory, Converter={StaticResource DetailHistoryConverter}}"/>
                    </Border>
                    <TextBlock Opacity="0.7"
                               Text="{Binding SelectedHistoryRange}"/>
                </StackPanel>
                <TextBlock IsVisible="{Binding !Details.Count}"
                           Opacity="0.7"
                           Text="{x:Static language:Resources.DetailsEmpty}"
                           TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Details}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailViewModel">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Margin="0,8,0,4"
                                           FontWeight="SemiBold"
                                           IsVisible="{Binding IsFirstAdvanced}"
                                           Text="{x:Static language:Resources.DetailsAdvanced}"/>
                                <TextBlock Opacity="0.7"
                                           Text="{Binding Name}"/>
                                <SelectableTextBlock Text="{Binding Value}"
                                                     TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Grid.ColumnSpan="2"
                Padding="20,10"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HardwareWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding HardwareWarning}"/>
                <TextBlock Opacity="0.7"
                           Text="{Binding Status}"/>
            </StackPanel>
        </Border>
    </Grid>

</ui:DecoratedWindow>
