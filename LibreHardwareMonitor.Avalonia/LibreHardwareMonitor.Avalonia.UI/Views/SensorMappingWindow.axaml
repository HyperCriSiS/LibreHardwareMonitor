<ui:DecoratedWindow x:Class="LibreHardwareMonitor.Avalonia.UI.Views.SensorMappingWindow"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:language="using:LibreHardwareMonitor.Avalonia.Localization.Resources"
                    xmlns:ui="using:BlackSharp.UI.Avalonia.Controls"
                    xmlns:vm="using:LibreHardwareMonitor.Avalonia.Mvvm.ViewModels"
                    x:DataType="vm:SensorMappingViewModel"
                    Title="{x:Static language:Resources.MappingTitle}"
                    Icon="{StaticResource LibreHardwareMonitorWindowIcon}"
                    TitleBarIcon="{StaticResource LibreHardwareMonitorTitleBarIcon}"
                    Width="720" Height="560"
                    MinWidth="480" MinHeight="360"
                    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">
        <TextBlock Grid.Row="0"
                   Text="{Binding Status}"
                   TextWrapping="Wrap"/>

        <ProgressBar Grid.Row="1"
                     Margin="0,12,0,0"
                     Maximum="100"
                     IsVisible="{Binding IsRunning}"
                     Value="{Binding Progress}"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,12,0,12">
            <Button Content="{x:Static language:Resources.MappingStart}"
                    IsEnabled="{Binding !IsRunning}"
                    Click="OnStartClick"/>
            <Button Content="{x:Static language:Resources.MappingCancel}"
                    IsEnabled="{Binding IsRunning}"
                    Click="OnCancelClick"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SensorMappingResultViewModel">
                        <StackPanel Margin="0,0,0,12">
                            <SelectableTextBlock FontWeight="SemiBold"
                                                 Text="{Binding Sensor}"/>
                            <SelectableTextBlock Text="{Binding Description}"
                                                 TextWrapping="Wrap"/>
                            <SelectableTextBlock Opacity="0.7"
                                                 IsVisible="{Binding Rise, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 Text="{Binding Rise}"/>
                            <SelectableTextBlock Opacity="0.7"
                                                 IsVisible="{Binding SameValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 Text="{Binding SameValue}"
                                                 TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,4,0,0">
                                <Button Content="{x:Static language:Resources.MappingRename}"
                                        Click="OnRenameClick"/>
                                <Button Content="{x:Static language:Resources.MappingHide}"
                                        IsVisible="{Binding CanHide}"
                                        Click="OnHideClick"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</ui:DecoratedWindow>
